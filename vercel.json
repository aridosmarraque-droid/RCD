{
  "framework": "vite",
  "installCommand": "env -u npm_config_cache_dir npm install",
  "buildCommand": "env -u npm_config_cache_dir npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
